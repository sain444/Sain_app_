# Copy this file to .env in the same folder (apps/mobile/.env) and fill in
# your server's URL. Expo automatically loads variables prefixed with
# EXPO_PUBLIC_ into the app at build/start time — no extra config needed.
#
# Local development (server running on your own machine):
#   - Simulator on the same machine: http://localhost:4000
#   - Android emulator: http://10.0.2.2:4000
#   - Physical device on the same WiFi: http://<your-computer's-LAN-IP>:4000
#
# Production (server deployed on Railway or similar):
#   EXPO_PUBLIC_API_URL=https://your-app.up.railway.app
EXPO_PUBLIC_API_URL=http://localhost:4000
