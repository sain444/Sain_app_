# --- Server ---
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:8081

# --- Database ---
DATABASE_URL="postgresql://loom:loom@localhost:5432/loom?schema=public"

# --- Redis ---
REDIS_URL="redis://localhost:6379"

# --- Auth / JWT ---
JWT_ACCESS_SECRET=replace_with_a_long_random_string
JWT_REFRESH_SECRET=replace_with_a_different_long_random_string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# --- Password reset email delivery ---
# Free option: Gmail SMTP via an App Password.
# 1. Go to https://myaccount.google.com/apppasswords
# 2. Sign in with the Gmail account you want reset emails sent FROM
# 3. Create an "App Password" (requires 2-Step Verification to be on)
# 4. Paste the 16-character password below (remove spaces)
# Without this set, password-reset codes are only logged to the server
# console — fine for your own testing, NOT acceptable for real users.
GMAIL_USER=youraddress@gmail.com
GMAIL_APP_PASSWORD=

# --- Media storage (S3-compatible) ---
# All optional. Without these, media uploads (photos/videos/files/voice
# messages) fall back to local disk storage on the server itself — fine for
# local development, but NOTE: this does NOT survive a Railway redeploy
# (the filesystem is ephemeral there). Configure real S3-compatible storage
# (AWS S3, Cloudflare R2, Backblaze B2, etc.) before relying on this for
# real users.
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# --- TURN/STUN (for WebRTC calls across different networks) ---
# Optional for same-WiFi testing (STUN alone, hardcoded to a public Google
# STUN server, is used automatically). For calls to work reliably when
# callers are on different networks/behind strict NATs, you need a TURN
# relay — this is realistically NOT free at meaningful scale. Options:
# self-host coturn (free but needs a server with a public IP), or a managed
# provider (Twilio, Metered, Xirsys — usually free tier + paid beyond it).
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
